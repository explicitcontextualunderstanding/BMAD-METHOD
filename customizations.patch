+            "story_id": story_id,
+            "epic_id": epic_id,
+            "relevant_patterns": [],
+            "lessons_learned": [],
+            "technical_guidance": {},
+            "learning_resources": [],
+            "evidence_templates": []
+        }
+
+        for memory in memories:
+            if memory.get("knowledge_transfer", {}).get("patterns"):
