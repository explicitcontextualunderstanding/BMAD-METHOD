+if docker run --rm --gpus all "$CONTAINER" bash -c "
+import torch
+import tensorrt as trt
+import sys
+print('Testing container functionality...')
+
+# Test PyTorch
+try:
+    print(f'✅ PyTorch version: {torch.__version__}')
